<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a 1:1 frame drawn as a dot matrix, with the lens at its centre.

  Dot-matrix construction in pure white on pure black is the Nothing OS visual
  language, and it is the right one to borrow rather than a coincidence of taste:
  this app has no accent colour, no gradient and no aspect-ratio setting, so the icon
  has exactly three things to say — square, monochrome, camera.

  The dots grow along the diagonal, finest at the top-left and coarsest at the
  bottom-right. That ramp is a halftone: it is the icon saying "black through grey to
  white", which is the entire subject of the app, and it is what keeps the mark from
  reading as a keypad or a QR code.

  Geometry is a 5x5 grid spanning 40dp on the 108dp canvas. The outermost edge of the
  largest dot sits 32.3dp from the centre, inside the 33dp adaptive safe radius, so
  nothing clips under a circular mask. The same white geometry feeds the monochrome
  (themed) icon, which is why there is no colour here but white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The frame: sixteen dots, ramped from fine to coarse along the diagonal. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="
            M34,34 m-1.7,0 a1.7,1.7 0 1,1 3.4,0 a1.7,1.7 0 1,1 -3.4,0 Z
            M44,34 m-1.99,0 a1.99,1.99 0 1,1 3.97,0 a1.99,1.99 0 1,1 -3.97,0 Z
            M54,34 m-2.27,0 a2.27,2.27 0 1,1 4.55,0 a2.27,2.27 0 1,1 -4.55,0 Z
            M64,34 m-2.56,0 a2.56,2.56 0 1,1 5.12,0 a2.56,2.56 0 1,1 -5.12,0 Z
            M74,34 m-2.85,0 a2.85,2.85 0 1,1 5.7,0 a2.85,2.85 0 1,1 -5.7,0 Z
            M34,44 m-1.99,0 a1.99,1.99 0 1,1 3.97,0 a1.99,1.99 0 1,1 -3.97,0 Z
            M74,44 m-3.14,0 a3.14,3.14 0 1,1 6.28,0 a3.14,3.14 0 1,1 -6.28,0 Z
            M34,54 m-2.27,0 a2.27,2.27 0 1,1 4.55,0 a2.27,2.27 0 1,1 -4.55,0 Z
            M74,54 m-3.42,0 a3.42,3.42 0 1,1 6.85,0 a3.42,3.42 0 1,1 -6.85,0 Z
            M34,64 m-2.56,0 a2.56,2.56 0 1,1 5.12,0 a2.56,2.56 0 1,1 -5.12,0 Z
            M74,64 m-3.71,0 a3.71,3.71 0 1,1 7.42,0 a3.71,3.71 0 1,1 -7.42,0 Z
            M34,74 m-2.85,0 a2.85,2.85 0 1,1 5.7,0 a2.85,2.85 0 1,1 -5.7,0 Z
            M44,74 m-3.14,0 a3.14,3.14 0 1,1 6.28,0 a3.14,3.14 0 1,1 -6.28,0 Z
            M54,74 m-3.42,0 a3.42,3.42 0 1,1 6.85,0 a3.42,3.42 0 1,1 -6.85,0 Z
            M64,74 m-3.71,0 a3.71,3.71 0 1,1 7.42,0 a3.71,3.71 0 1,1 -7.42,0 Z
            M74,74 m-4,0 a4,4 0 1,1 8,0 a4,4 0 1,1 -8,0 Z" />

    <!-- The lens. Solid, because at 48px a ring closes up into a smudge. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-6.4,0 a6.4,6.4 0 1,1 12.8,0 a6.4,6.4 0 1,1 -12.8,0 Z" />

</vector>
